# Get your Groq API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Required for private repos, webhooks, commit comments, and diff fetching.
GITHUB_TOKEN=your_github_token_here
WEBHOOK_SECRET=optional_github_webhook_secret

# Optional model override.
GROQ_MODEL=llama-3.1-8b-instant

# Optional Jira automation for critical/high issues.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=YOURPROJECT

# Optional report location.
REPORTS_DIR=reports
